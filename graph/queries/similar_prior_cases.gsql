// Hybrid retrieval: vector search for cases that *read* like this one, then a
// graph hop to keep only those whose entities actually connect.
//
// This is the part that is genuinely graph+vector rather than either alone. A
// pure vector search over 5,565 narratives returns cases with similar prose;
// the traversal asks whether the match shares a card, a device or a region
// with the case under investigation. Both signals go back, separately, so the
// evidence ledger can weight a connected match above a merely similar one.

CREATE OR REPLACE QUERY similar_prior_cases (
  LIST<float> query_vector,
  STRING card_id,
  STRING device_id,
  STRING billing_region,
  INT k
) SYNTAX v3 {
  MapAccum<Vertex, Float> @@similarity;
  SumAccum<INT> @connected;
  SetAccum<STRING> @links;

  // Top-k by narrative similarity.
  cands = vectorSearch({ClosedCase.emb}, query_vector, k, {distance_map: @@similarity});

  // Does the candidate touch the same card?
  same_card = SELECT c FROM (cands:c) -(ON_CARD>|CONNECTED_TO>)- Card:cd
              WHERE cd.card_id == card_id
              ACCUM c.@connected += 1, c.@links += "card:" + cd.card_id;

  // Or the same device profile, via its transactions?
  same_device = SELECT c FROM (cands:c) -(INVOLVES>)- Transaction:t -(FROM_DEVICE>)- DeviceProfile:d
                WHERE d.device_id == device_id
                ACCUM c.@connected += 1, c.@links += "device:" + d.device_id;

  // Or the same billing region?
  same_region = SELECT c FROM (cands:c) -(INVOLVES>)- Transaction:t
                WHERE t.billing_region == billing_region
                ACCUM c.@connected += 1, c.@links += "region:" + t.billing_region;

  PRINT cands[cands.case_id, cands.outcome, cands.pattern, cands.exposure_usd,
              cands.analyst_notes, cands.@connected, cands.@links];
  PRINT @@similarity;
}
