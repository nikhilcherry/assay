// N2 -- the flagged card's weakly connected component, computed in TigerGraph with the
// same definition as assay/r2/rings.py:build_card_graph, so the ledger can use either:
// cards are linked by a shared element seen in [as_of - window_days, as_of], where an
// element is a specific device profile ("dev:"), id_23 + device ("id23:"), or device +
// billing region ("dev_addr:"). A device is specific when its profile is non-empty, has no
// "?" and is not a generic OS/browser family. Elements seen on more than `cap` cards are
// dropped (issuer buckets would otherwise merge everything). The Python caller applies
// the ring rule: 3..30 members and a prior confirmed-fraud member or a risk_score >= 0.70.
USE GRAPH assay

CREATE OR REPLACE QUERY r2_ring_wcc(
  VERTEX<Card> seed_card,
  DATETIME as_of,
  INT window_days = 30,
  INT cap = 15
) FOR GRAPH assay SYNTAX v2 {
  MapAccum<STRING, SetAccum<STRING>> @@elem_cards;
  MapAccum<STRING, SetAccum<STRING>> @@card_elems;
  SetAccum<STRING> @@members;
  SetAccum<STRING> @@frontier;
  SetAccum<STRING> @@next;
  SetAccum<STRING> @@shared_elements;
  SetAccum<STRING> @@txn_ids;
  SumAccum<DOUBLE> @@total_amount;
  MaxAccum<DOUBLE> @@max_risk;
  SetAccum<STRING> @@prior_fraud_cards;
  SetAccum<STRING> @@prior_case_ids;
  DATETIME t_start;
  t_start = datetime_sub(as_of, INTERVAL window_days DAY);

  // 1. Elements in the window, from transactions on specific devices only
  AllCards = {Card.*};
  WinTxns = SELECT t FROM AllCards:c -(MADE>)- Txn:t
            WHERE t.ts >= t_start AND t.ts <= as_of
              AND t.device_profile != ""
              AND NOT (t.device_profile LIKE "%?%")
              AND NOT (t.device_profile LIKE "Windows |%" OR t.device_profile LIKE "MacOS |%"
                       OR t.device_profile LIKE "iOS Device |%" OR t.device_profile LIKE "Trident/7.0 |%"
                       OR t.device_profile LIKE "rv:11.0 |%" OR t.device_profile LIKE "Linux |%")
              AND NOT (t.device_profile IN ("Windows", "MacOS", "iOS Device", "Trident/7.0", "rv:11.0", "Linux"))
            ACCUM
              @@elem_cards += ("dev:" + t.device_profile -> c.card_id),
              IF t.id_23 != "" AND lower(t.id_23) != "nan" THEN
                @@elem_cards += ("id23:" + t.id_23 + ":" + t.device_profile -> c.card_id)
              END,
              IF t.addr1 > 0 THEN
                @@elem_cards += ("dev_addr:" + t.device_profile + ":" + to_string(t.addr1) -> c.card_id)
              END;

  // 2. Keep elements shared by 2..cap cards; index them by card
  FOREACH (e, cs) IN @@elem_cards DO
    IF cs.size() >= 2 AND cs.size() <= cap THEN
      FOREACH c IN cs DO
        @@card_elems += (c -> e);
      END;
    END;
  END;

  // 3. Breadth-first search from the seed card over the kept elements = its component
  Seed = {seed_card};
  Seed = SELECT s FROM Seed:s POST-ACCUM @@members += s.card_id, @@frontier += s.card_id;
  WHILE @@frontier.size() > 0 LIMIT 100 DO
    @@next.clear();
    FOREACH c IN @@frontier DO
      FOREACH e IN @@card_elems.get(c) DO
        @@shared_elements += e;
        FOREACH c2 IN @@elem_cards.get(e) DO
          IF NOT @@members.contains(c2) THEN
            @@next += c2;
          END;
        END;
      END;
    END;
    @@members += @@next;
    @@frontier.clear();
    @@frontier += @@next;
  END;

  // 4. Members' window volume, strongest bank score and prior confirmed fraud (closed by as_of)
  RingCards = SELECT c FROM AllCards:c WHERE @@members.contains(c.card_id);
  RingTxns = SELECT t FROM RingCards:c -(MADE>)- Txn:t
             WHERE t.ts >= t_start AND t.ts <= as_of
             ACCUM @@txn_ids += t.txn_id, @@total_amount += t.amount, @@max_risk += t.risk_score;
  PriorCases = SELECT cc FROM RingCards:c -(HAS_CLOSED_CASE>)- ClosedCase:cc
               WHERE cc.closed_at <= as_of AND cc.outcome == "confirmed_fraud"
               ACCUM @@prior_fraud_cards += c.card_id, @@prior_case_ids += cc.case_id;

  PRINT @@members AS members,
        @@shared_elements AS shared_elements,
        @@txn_ids AS txn_ids,
        @@total_amount AS total_amount,
        @@max_risk AS max_risk,
        @@prior_fraud_cards AS prior_fraud_cards,
        @@prior_case_ids AS prior_case_ids;
}
